"""Type stubs for the _credish C extension."""

from typing import Any, Optional

# The db handle is an opaque capsule
class _Store: ...

def open(
    data_dir: str = ".",
    persistence: str = "hybrid",
    save_interval: int = 300,
    aof_fsync: str = "everysec",
    db: int = 0,
) -> _Store: ...

def close(handle: _Store) -> None: ...
def ping(handle: _Store) -> str: ...
def flushdb(handle: _Store) -> bool: ...
def dbsize(handle: _Store, db: int = 0) -> int: ...
def save(handle: _Store) -> bool: ...
def bgsave(handle: _Store) -> bool: ...
def select(handle: _Store, db: int) -> bool: ...

# String
def get(handle: _Store, key: str | bytes) -> bytes | None: ...
def set(
    handle: _Store,
    key: str | bytes,
    value: str | bytes | int | float,
    ex: int = -1,
    px: int = -1,
    nx: bool = False,
    xx: bool = False,
) -> bool | None: ...
def delete(handle: _Store, keys: list[str | bytes]) -> int: ...
def exists(handle: _Store, keys: list[str | bytes]) -> int: ...
def expire(handle: _Store, key: str | bytes, seconds: int) -> bool: ...
def pexpire(handle: _Store, key: str | bytes, milliseconds: int) -> bool: ...
def persist(handle: _Store, key: str | bytes) -> bool: ...
def ttl(handle: _Store, key: str | bytes) -> int: ...
def pttl(handle: _Store, key: str | bytes) -> int: ...
def type_(handle: _Store, key: str | bytes) -> str: ...
def incrby(handle: _Store, key: str | bytes, amount: int) -> int: ...

# List
def lpush(handle: _Store, key: str | bytes, values: list[Any]) -> int: ...
def rpush(handle: _Store, key: str | bytes, values: list[Any]) -> int: ...
def lrange(handle: _Store, key: str | bytes, start: int, stop: int) -> list[bytes]: ...
def llen(handle: _Store, key: str | bytes) -> int: ...
